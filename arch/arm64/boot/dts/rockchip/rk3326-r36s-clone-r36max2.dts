/*
 * EXPERIMENTAL - not tested on hardware by andr36oid. Keep a copy of the
 * files you replace so you can go back.
 *
 * R36 Max 2 (arkos4clone "r36max2"; XF45V, RF45H, RF45V and DC45V use the
 * same panel and LCD pins there). G80 wiring: LCD reset GPIO3_D3, LCD power
 * GPIO3_A3. 1024x768 panel with the same init sequence as the R36 Ultra X.
 *
 * Three buttons sit on other pins than on the G80 (stock DTB): R2
 * GPIO3_A0, L2 GPIO3_A6, Fn GPIO3_D2. Sticks: mux order 3 2 0 1.
 * Not carried over (needs hardware): the stock DTB switches USB power on
 * GPIO3_A4 active low (G80: active high) and has a second power switch
 * on GPIO0_A1 for the wifi module.
 * Boot with androidboot.lcd_density=304 as on the R46H.
 *
 * Panel values (delays, size, flags, init and exit sequence, timing) are
 * copied from the reference DTB:
 *   lcdyk0517/arkos4clone @2656e5b6, boot/dArkOS/consoles/r36max2
 *   init sequence 798 bytes, md5 f31ef4f72905
 */

/dts-v1/;

#include "rk3326-r36s-clone-ee.dtsi"

/ {
	model = "R36 Max 2 (experimental)";
};

&joypad {
	amux-channel-mapping = <3 2 0 1>;
	/delete-property/ invert-absy;
	invert-absry;
	pinctrl-0 = <&btn_pins &btn_pins_max2>;

	sw13 {
		gpios = <&gpio3 RK_PD2 GPIO_ACTIVE_LOW>;
	};
	sw20 {
		gpios = <&gpio3 RK_PA0 GPIO_ACTIVE_LOW>;
	};
	sw21 {
		gpios = <&gpio3 RK_PA6 GPIO_ACTIVE_LOW>;
	};
};

&pinctrl {
	btn-pins-max2 {
		btn_pins_max2: btn-pins-max2 {
			rockchip,pins =
				<3 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PA6 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PD2 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};

&dsi {
	panel@0 {
		prepare-delay-ms = <20>;
		reset-delay-ms = <20>;
		init-delay-ms = <20>;
		enable-delay-ms = <120>;
		disable-delay-ms = <20>;
		unprepare-delay-ms = <20>;
		width-mm = <153>;
		height-mm = <85>;
		dsi,flags = <(MIPI_DSI_MODE_VIDEO |
		      MIPI_DSI_MODE_VIDEO_BURST |
		      MIPI_DSI_MODE_EOT_PACKET |
		      MIPI_DSI_MODE_LPM)>;
		dsi,lanes = <4>;
		panel-init-sequence = [
			15 00 02 ee 01
			15 00 02 ea 07
