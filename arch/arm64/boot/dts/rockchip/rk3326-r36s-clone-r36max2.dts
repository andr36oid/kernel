		panel-exit-sequence = [
			05 00 01 28
			05 00 01 10
		];
		display-timings {
			/* one mode only: the R36S alternates do not fit this panel */
			/delete-node/ timing1;
			/delete-node/ timing2;
		};
	};
};

&timing0 {
	clock-frequency = <62000000>;
	hactive = <1024>;
	vactive = <768>;
	hfront-porch = <90>;
	hsync-len = <80>;
	hback-porch = <80>;
	vfront-porch = <27>;	/* was 16: 60.8 Hz; 60.01 Hz, same pixel clock */
	vsync-len = <8>;
	vback-porch = <8>;
	hsync-active = <0>;
	vsync-active = <0>;
	de-active = <0>;
	pixelclk-active = <0>;
};

&rk817 {
	battery {
		/* stock values */
		design_capacity = <3380>;
		design_qmax = <3718>;
		bat_res = <100>;
	};

	/* the speaker runs through an external amplifier (stock "use-ext-amplifier") */
	codec {
		use-ext-amplifier;
	};
};
