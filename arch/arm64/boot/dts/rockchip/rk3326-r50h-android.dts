/*
 * EXPERIMENTAL - not tested on hardware by andr36oid. Keep a copy of the
 * files you replace so you can go back.
 *
 * HL-R50H-V11 (R50H): the R46H board with a 720x1280 panel mounted
 * sideways. Against rk3326-r46h-android.dts: other panel, Fn button on
 * GPIO0_B5 (R46H: GPIO2_A4), so no charge LED on that pin.
 * The same DTB is in arkos4clone as "r50h" (same init sequence).
 * Boot with androidboot.sf_orientation=ORIENTATION_270 fbcon=rotate:3
 * (stock boot.ini has fbcon=rotate:3 and the panel node rotation = 90).
 *
 * Panel values (delays, size, flags, init and exit sequence, timing) are
 * copied from the reference DTB:
 *   djparentx/dArkOSen-R36S @28f5427f, boot/dtb/r36s/HL-R50H-V11 2026-03-31 2617
 *   init sequence 816 bytes, md5 ce000ad21b3f
 */

/dts-v1/;

#include "rk3326-r46h-android.dts"

/ {
	model = "R50H (experimental)";
};

&leds {
	/* GPIO0_B5 is the Fn button on this board */
	/delete-node/ charge;
};

&joypad {
	/delete-property/ andr36oid,missing-buttons;
	/delete-property/ switch-rxy;
	/delete-property/ invert-absry;

	sw13 {
		gpios = <&gpio0 RK_PB5 GPIO_ACTIVE_LOW>;
	};
};

&pinctrl {
	btn-pins-r50h {
		btn_pins_r50h: btn-pins-r50h {
			rockchip,pins = <0 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};

&joypad {
	pinctrl-0 = <&btn_pins &btn_pins_r50h>;
};

&dsi {
	panel@0 {
		compatible = "simple-panel-dsi";
		prepare-delay-ms = <20>;
		reset-delay-ms = <150>;
		init-delay-ms = <20>;
		enable-delay-ms = <120>;
		disable-delay-ms = <50>;
		unprepare-delay-ms = <20>;
		width-mm = <62>;
		height-mm = <110>;
		dsi,flags = <(MIPI_DSI_MODE_VIDEO |
		      MIPI_DSI_MODE_VIDEO_BURST |
		      MIPI_DSI_MODE_EOT_PACKET |
		      MIPI_DSI_MODE_LPM)>;
		dsi,lanes = <4>;
		panel-init-sequence = [
			39 00 04 ff 98 81 07
			15 00 02 03 20
			15 00 02 04 06
			15 00 02 05 00
			15 00 02 06 01
			15 00 02 07 00
