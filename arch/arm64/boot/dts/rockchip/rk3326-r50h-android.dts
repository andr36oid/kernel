			05 78 01 11
			05 14 01 29
		];
		panel-exit-sequence = [
			05 14 01 28
			05 0a 01 10
		];
		display-timings {
			/* one mode only: the R36S alternates do not fit this panel */
			/delete-node/ timing1;
			/delete-node/ timing2;
		};
	};
};

&timing0 {
	clock-frequency = <64000000>;
	hactive = <720>;
	vactive = <1280>;
	hfront-porch = <40>;
	hsync-len = <8>;
	hback-porch = <50>;
	vfront-porch = <8>;	/* stock value, 60.05 Hz */
	vsync-len = <6>;
	vback-porch = <9>;
	hsync-active = <0>;
	vsync-active = <0>;
	de-active = <0>;
	pixelclk-active = <0>;
};
