		panel-exit-sequence = [
			05 14 01 28
			05 0a 01 10
		];
		display-timings {
			/* one mode only: the R36S alternates do not fit this panel */
			/delete-node/ timing1;
			/delete-node/ timing2;
		};
	};
};

&timing0 {
	clock-frequency = <26400000>;
	hactive = <640>;
	vactive = <480>;
	hfront-porch = <119>;
	hsync-len = <2>;
	hback-porch = <119>;
	vfront-porch = <13>;	/* stock value, 60.00 Hz */
	vsync-len = <2>;
	vback-porch = <5>;
	hsync-active = <0>;
	vsync-active = <0>;
	de-active = <0>;
	pixelclk-active = <0>;
};

/* This inherited board has no checked packed loader counterpart. */
&{/dsi@ff450000/panel@0} {
	/delete-property/ andr36oid,adopt-loader-panel;
};
