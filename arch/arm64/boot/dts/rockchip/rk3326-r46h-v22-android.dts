/*
 * EXPERIMENTAL - not tested on hardware by andr36oid. Keep a copy of the
 * files you replace so you can go back.
 *
 * HL-R46H-V22: an R46H board revision that ships a 640x480 panel (the
 * init sequence of the HL-R36S-V30 panel) in place of the 1024x768 one.
 * With the R46H files the screen stays black or shows garbage.
 * Against rk3326-r46h-android.dts: other panel; USB host power switch on
 * GPIO0_B7 (as on R36S V21 2551/2552).
 * Do not pass androidboot.lcd_density=304: this is a 640x480 screen.
 *
 * Panel values (delays, size, flags, init and exit sequence, timing) are
 * copied from the reference DTB:
 *   djparentx/dArkOSen-R36S @28f5427f, boot/dtb/r36s/HL-R46H-V22 2026-03-12
 *   init sequence 928 bytes, md5 f260403c4edc
 */

/dts-v1/;

#include "rk3326-r46h-android.dts"

/ {
	model = "R46H V22 (experimental)";
};

/ {
	vcc_host: vcc-host {
		compatible = "regulator-fixed";
		regulator-name = "vcc_host";
		gpio = <&gpio0 RK_PB7 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vccsys>;
	};
};

/* GPIO0_B7 is the PWM0 pin: PWM0 keeps running for the joypad node, off the pin */
&pwm0 {
	pinctrl-0 = <&vcc_host_en>;
};

&joypad {
	andr36oid,no-rumble;
	/* stock V22 DTB: right stick not swapped or inverted as on the R46H */
	/delete-property/ switch-rxy;
	/delete-property/ invert-absry;
};

&pinctrl {
	vcc-host {
		vcc_host_en: vcc-host-en {
			rockchip,pins = <0 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&dsi {
	panel@0 {
		compatible = "simple-panel-dsi";
		prepare-delay-ms = <2>;
		reset-delay-ms = <1>;
		init-delay-ms = <20>;
		enable-delay-ms = <120>;
		disable-delay-ms = <50>;
		unprepare-delay-ms = <20>;
		width-mm = <52>;
		height-mm = <70>;
		dsi,flags = <(MIPI_DSI_MODE_VIDEO |
		      MIPI_DSI_MODE_VIDEO_BURST |
		      MIPI_DSI_MODE_EOT_PACKET |
		      MIPI_DSI_MODE_LPM)>;
		dsi,lanes = <4>;
		panel-init-sequence = [
			15 00 02 ff 30
			15 00 02 ff 52
			15 00 02 ff 01
			15 00 02 e3 00
			15 00 02 40 0a
