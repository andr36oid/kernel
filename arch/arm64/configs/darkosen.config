CONFIG_BT_HCIBFUSB=m
CONFIG_BT_MRVL=m
CONFIG_BT_MRVL_SDIO=m
CONFIG_USB_SERIAL=m
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_USB_RTL8150=m
CONFIG_USB_MON=m
CONFIG_IPV6=m
CONFIG_NET_KEY=m
CONFIG_SPI_SPIDEV=m
CONFIG_NTFS_FS=m
CONFIG_XFS_FS=m

