# Matched ARMv8.0 Mali-G31 g7p1 userspace; keep exactly one KMD.
CONFIG_MALI_BIFROST_G7P1_FOR_ANDROID=y
CONFIG_MALI_BIFROST=y
CONFIG_MALI_PLATFORM_NAME="rk"
CONFIG_MALI_BIFROST_DEVFREQ=y
CONFIG_MALI_BIFROST_DMA_FENCE=y
# CONFIG_MALI_CSF_SUPPORT is not set
# CONFIG_MALI_BIFROST_NO_MALI is not set
CONFIG_LOCALVERSION="-rk3326-andr36oid-5.10-vulkan-g7p1"
